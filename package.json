{
  "name": "sticky-notes-ai",
  "version": "0.1.0",
  "description": "macOS-native sticky notes with AI-ready task detection",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE STICKY_AI_STORE_PATH=./.data electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE STICKY_AI_STORE_PATH=./.data electron . --watch",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac --dmg",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.{js,html,css}"
  },
  "build": {
    "appId": "com.stickyai.app",
    "productName": "Sticky AI",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "darkModeSupport": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-positioner": "^4.1.0",
    "electron-store": "^8.1.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "dmg-license": "^1.0.11",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9.35.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
